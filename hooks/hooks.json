{
  "description": "WikiSkill hooks: capture execution traces on Stop (Raw Layer), inject loop status on SessionStart, and record every skill invocation on PostToolUse(Skill) for usage/usefulness statistics. All no-op until the project runs /wikiskill:init.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture_trace.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/record_skill_use.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
